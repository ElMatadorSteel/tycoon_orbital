--!strict
-- Asteroid rarity catalogue for the Railgun mining side-feature: pure data
-- plus the weighted-pick/reward-roll rules. Takes its own `Rules` (the tier
-- list) as a parameter rather than reading Shared/Balance directly, same as
-- every other Domain module (see CLAUDE.md's "Domain code takes config as
-- parameters").
--
-- Randomness: nothing in this codebase has needed it before now. To keep
-- this pure and Lune-testable with pinned reference points, every random
-- draw is generated by the CALLER (Application, via math.random()) and
-- passed in as a `roll: number` in [0, 1) -- the same "inject the
-- non-deterministic input" shape Ports.Clock already uses.

export type TierDef = {
	id: string,
	name: string,
	weight: number, -- relative spawn probability
	minReward: number,
	maxReward: number,
}

export type Rules = { tiers: { TierDef } }

local AsteroidTiers = {}

function AsteroidTiers.get(id: string, rules: Rules): TierDef?
	for _, tier in rules.tiers do
		if tier.id == id then
			return tier
		end
	end
	return nil
end

local function totalWeight(rules: Rules): number
	local total = 0
	for _, tier in rules.tiers do
		total += tier.weight
	end
	return total
end

-- Weighted pick: walks the tier list in order, accumulating weight, and
-- returns the first tier whose cumulative share exceeds `roll * totalWeight`.
-- roll = 0 always lands on the first tier with positive weight; roll just
-- under 1 always lands on the last -- exact ties (roll landing precisely on
-- a boundary) fall to the NEXT tier, not the current one (see the spec's
-- pinned boundary cases).
function AsteroidTiers.pick(roll: number, rules: Rules): string
	local total = totalWeight(rules)
	if total <= 0 or #rules.tiers == 0 then
		error("AsteroidTiers.pick: rules.tiers is empty or has zero total weight", 2)
	end
	local target = math.clamp(roll, 0, 1) * total
	local cumulative = 0
	for _, tier in rules.tiers do
		cumulative += tier.weight
		if target < cumulative then
			return tier.id
		end
	end
	return rules.tiers[#rules.tiers].id
end

-- Linear interpolation between the tier's min/max reward, floored to a whole
-- credit -- profile.credits is always an integer (see Profile.sanitize).
function AsteroidTiers.reward(tierId: string, roll: number, rules: Rules): number
	local tier = AsteroidTiers.get(tierId, rules)
	if not tier then
		error(`AsteroidTiers.reward: unknown tier "{tierId}"`, 2)
	end
	local t = math.clamp(roll, 0, 1)
	return math.floor(tier.minReward + (tier.maxReward - tier.minReward) * t)
end

return AsteroidTiers
